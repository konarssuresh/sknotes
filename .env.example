# Phase 2+ — copy to .env.local; never commit real secrets.

# MongoDB Atlas (required)
MONGODB_URI=
# Optional: override database name when not in the URI
# MONGODB_DB_NAME=
# Optional: connection pool size (integer)
# MONGODB_MAX_POOL_SIZE=
# Optional: true | false — defaults to true for mongodb+srv:// URIs
# MONGODB_USE_TRANSACTIONS=false

# Better Auth (required)
BETTER_AUTH_SECRET=
# Server base URL — must match the browser origin (local, preview, or production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Set to 1 in Netlify to accept scrubbed POST /api/client-error reports (no note content).
# CLIENT_ERROR_REPORTING_ENABLED=1

# Google OAuth (Better Auth) — omit both to disable Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend — server-only; required in production)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# CI / E2E only — never set on Netlify production
# E2E_TEST_MODE=1

# Local PWA registration tests in non-production builds — see docs/integrations/pwa-next-netlify.md
# NEXT_PUBLIC_E2E_PWA=1
